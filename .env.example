# Supabase — pegue esses valores em supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para scripts server-side (seed, funções administrativas).
# NUNCA exponha esta chave no navegador nem faça commit dela.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em metadata / SEO / sitemap / canonical).
# Em modo demonstração (ver abaixo), o site ignora este valor e usa a
# URL da própria Vercel automaticamente — só importa de verdade quando
# NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_SITE_URL=https://www.canelidoceria.com.br

# Interruptor único entre demonstração e site oficial.
#   ausente ou "true"  -> MODO DEMONSTRAÇÃO: não indexa no Google, não
#                          abre WhatsApp/delivery reais, não salva leads,
#                          não carrega analytics — mas toda a interface
#                          (cardápio, carrinho, painel admin) continua
#                          navegável para apresentar o projeto.
#   "false"            -> MODO OFICIAL: tudo funciona normalmente.
# Ao vender/lançar o site, troque para "false" e faça um redeploy — não
# precisa mexer em mais nada.
NEXT_PUBLIC_DEMO_MODE=true

# Opcional — Google Tag Manager. Só carrega depois que o visitante aceita
# o aviso de cookies. Deixe em branco para não carregar nenhum analytics.
NEXT_PUBLIC_GTM_ID=
